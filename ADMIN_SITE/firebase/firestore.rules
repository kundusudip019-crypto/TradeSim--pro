rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {


    // =========================================================
    // HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }


    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }


    function isAdmin() {
      return signedIn()
        && request.auth.token.email
          == "kundusudip019@gmail.com";
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      /*
       * User can read only their own account.
       */

      allow read:
        if isOwner(userId)
        || isAdmin();


      /*
       * IMPORTANT:
       *
       * Normal client cannot directly modify balance.
       *
       * Balance changes are performed by
       * Firebase Admin SDK on the server.
       */

      allow create:
        if isOwner(userId);


      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    // =========================================================
    // TRADES
    // =========================================================

    match /trades/{tradeId} {

      /*
       * User can see their own trades.
       */

      allow read:
        if signedIn()
        && resource.data.userId
          == request.auth.uid
        || isAdmin();


      /*
       * IMPORTANT:
       *
       * Trade creation is handled by
       * the secure server endpoint:
       *
       * POST /api/trade/open
       *
       * Firebase Admin SDK bypasses these rules.
       *
       * Therefore browser/client cannot create
       * fake trades or manipulate balance.
       */

      allow create:
        if false;


      /*
       * Trade settlement is also server-side.
       */

      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    // =========================================================
    // WALLET TRANSACTIONS
    // =========================================================

    match /walletTransactions/{transactionId} {

      /*
       * User can read their own wallet history.
       */

      allow read:
        if signedIn()
        && resource.data.userId
          == request.auth.uid
        || isAdmin();


      /*
       * Wallet transaction records are created
       * by the secure backend.
       */

      allow create:
        if false;


      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    // =========================================================
    // TOP-UP REQUESTS
    // =========================================================

    match /topupRequests/{requestId} {

      /*
       * User can see only their own requests.
       */

      allow read:
        if signedIn()
        && resource.data.userId
          == request.auth.uid
        || isAdmin();


      /*
       * Top-up request creation should happen
       * through the secure payment server.
       */

      allow create:
        if false;


      /*
       * Admin handles approval/rejection.
       */

      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    // =========================================================
    // WITHDRAWAL REQUESTS
    // =========================================================

    match /withdrawalRequests/{requestId} {

      /*
       * User can see only their own withdrawal requests.
       */

      allow read:
        if signedIn()
        && resource.data.userId
          == request.auth.uid
        || isAdmin();


      /*
       * Withdrawal request creation happens
       * through the secure server.
       */

      allow create:
        if false;


      /*
       * Admin handles approval/rejection.
       */

      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    // =========================================================
    // PRODUCTS
    // =========================================================

    match /products/{productId} {

      /*
       * Products can be viewed by logged-in users.
       */

      allow read:
        if signedIn();


      /*
       * Only admin can manage products.
       */

      allow create:
        if isAdmin();

      allow update:
        if isAdmin();

      allow delete:
        if isAdmin();

    }


    // =========================================================
    // ORDERS
    // =========================================================

    match /orders/{orderId} {

      /*
       * User can read their own orders.
       */

      allow read:
        if signedIn()
        && resource.data.userId
          == request.auth.uid
        || isAdmin();


      /*
       * Orders should not be used to modify
       * wallet balance.
       */

      allow create:
        if signedIn()
        && request.resource.data.userId
          == request.auth.uid;


      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    // =========================================================
    // BALANCE TRANSACTIONS
    // =========================================================

    match /balanceTransactions/{transactionId} {

      allow read:
        if signedIn()
        && resource.data.userId
          == request.auth.uid
        || isAdmin();


      /*
       * Balance changes must happen through
       * trusted backend/Admin SDK.
       */

      allow create:
        if false;


      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {

      allow read, write:
        if false;

    }

  }
}