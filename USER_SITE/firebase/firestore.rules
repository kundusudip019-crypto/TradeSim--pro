rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isAdmin(){
      return signedIn() && request.auth.token.email == "kundusudip019@gmail.com";
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.active == resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["balance"])
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= resource.data.balance + 550
        && request.resource.data.balance >= resource.data.balance - 500
      );
      allow delete: if isAdmin();
    }

    match /trades/{tradeId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount >= 100
        && request.resource.data.amount <= 500
        && request.resource.data.status == "OPEN"
        && request.resource.data.sessionMinutes == 5;

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == "OPEN"
        && request.resource.data.status == "CLOSED"
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.amount == resource.data.amount
      );
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /marketState/{stateId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /topupRequests/{requestId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "PENDING" && request.resource.data.amount > 0;
      allow update, delete: if isAdmin();
    }

    match /withdrawalRequests/{requestId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "PENDING" && request.resource.data.amount >= 50;
      allow update, delete: if isAdmin();
    }

    match /walletTransactions/{txId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
  }
}
