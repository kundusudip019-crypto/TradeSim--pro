rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================================
       HELPER FUNCTIONS
    ===================================================== */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() ==
           "kundusudip019@gmail.com";
    }


    /* =====================================================
       USERS
    ===================================================== */

    match /users/{userId} {

      /*
       * User can read only their own account.
       */
      allow read:
        if isOwner(userId)
        || isAdmin();


      /*
       * IMPORTANT:
       *
       * Client MUST NOT directly change balance.
       *
       * Balance is changed by server.js
       * using Firebase Admin SDK.
       */
      allow create:
        if isOwner(userId);


      allow update:
        if isAdmin()
        ||
        (
          isOwner(userId)
          &&
          request.resource.data.balance ==
          resource.data.balance
        );


      allow delete:
        if isAdmin();

    }


    /* =====================================================
       TRADES
    ===================================================== */

    match /trades/{tradeId} {

      /*
       * User can see only their own trades.
       */
      allow read:
        if signedIn()
        &&
        (
          resource.data.userId ==
          request.auth.uid
          ||
          isAdmin()
        );


      /*
       * IMPORTANT:
       *
       * Client cannot create trades directly.
       *
       * server.js creates trades using
       * Firebase Admin SDK.
       */
      allow create:
        if false;


      /*
       * Client cannot modify trade result,
       * profit, status, amount, etc.
       *
       * server.js handles settlement.
       */
      allow update:
        if false;


      allow delete:
        if isAdmin();

    }


    /* =====================================================
       WALLET TRANSACTIONS
    ===================================================== */

    match /walletTransactions/{transactionId} {

      /*
       * User can view their own wallet history.
       */
      allow read:
        if signedIn()
        &&
        (
          resource.data.userId ==
          request.auth.uid
          ||
          isAdmin()
        );


      /*
       * Client cannot create fake wallet transactions.
       *
       * server.js creates these.
       */
      allow create:
        if false;


      allow update:
        if false;


      allow delete:
        if isAdmin();

    }


    /* =====================================================
       TOPUP REQUESTS
    ===================================================== */

    match /topupRequests/{requestId} {

      /*
       * User can create their own top-up request.
       */
      allow create:
        if signedIn()
        &&
        request.resource.data.userId ==
        request.auth.uid;


      /*
       * User can see only their own requests.
       * Admin can see all.
       */
      allow read:
        if signedIn()
        &&
        (
          resource.data.userId ==
          request.auth.uid
          ||
          isAdmin()
        );


      /*
       * User cannot approve/reject/change
       * their own payment request.
       */
      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    /* =====================================================
       WITHDRAWAL REQUESTS
    ===================================================== */

    match /withdrawalRequests/{requestId} {

      /*
       * User can create their own withdrawal request.
       */
      allow create:
        if signedIn()
        &&
        request.resource.data.userId ==
        request.auth.uid;


      /*
       * User can see their own requests.
       * Admin can see all.
       */
      allow read:
        if signedIn()
        &&
        (
          resource.data.userId ==
          request.auth.uid
          ||
          isAdmin()
        );


      /*
       * Only admin can change request status.
       */
      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    /* =====================================================
       PRODUCTS
    ===================================================== */

    match /products/{productId} {

      /*
       * Logged-in users can view products.
       */
      allow read:
        if signedIn();


      /*
       * Only admin can create/edit/delete products.
       */
      allow create, update, delete:
        if isAdmin();

    }


    /* =====================================================
       OFFERS
    ===================================================== */

    match /offers/{offerId} {

      /*
       * Logged-in users can view offers.
       */
      allow read:
        if signedIn();


      /*
       * Only admin can manage offers.
       */
      allow create, update, delete:
        if isAdmin();

    }


    /* =====================================================
       REFERRALS
    ===================================================== */

    match /referrals/{referralId} {

      /*
       * User can read their own referral record.
       */
      allow read:
        if signedIn()
        &&
        (
          resource.data.userId ==
          request.auth.uid
          ||
          resource.data.referrerId ==
          request.auth.uid
          ||
          isAdmin()
        );


      /*
       * Client cannot create fake referral records.
       */
      allow create:
        if false;


      /*
       * Only admin can modify referral records.
       */
      allow update, delete:
        if isAdmin();

    }


    /* =====================================================
       ORDERS
    ===================================================== */

    match /orders/{orderId} {

      allow read:
        if signedIn()
        &&
        (
          resource.data.userId ==
          request.auth.uid
          ||
          resource.data.customerEmail ==
          request.auth.token.email
          ||
          isAdmin()
        );


      allow create:
        if signedIn()
        &&
        request.resource.data.userId ==
        request.auth.uid;


      allow update, delete:
        if isAdmin();

    }


    /* =====================================================
       CUSTOMERS
    ===================================================== */

    match /customers/{customerId} {

      allow read:
        if isAdmin();


      allow create:
        if signedIn();


      allow update, delete:
        if isAdmin();

    }


    /* =====================================================
       USERS / ADMIN SETTINGS
    ===================================================== */

    match /settings/{settingId} {

      /*
       * Logged-in users can read website settings.
       */
      allow read:
        if signedIn();


      /*
       * Only admin can change settings.
       */
      allow create, update, delete:
        if isAdmin();

    }


    /* =====================================================
       DEFAULT DENY
    ===================================================== */

    match /{document=**} {

      allow read, write:
        if false;

    }

  }
}